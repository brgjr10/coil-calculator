{
  "name": "coil-calculator",
  "version": "1.0.0",
  "main": "main.js",
  "description": "Coil Calculator App",
  "scripts": {
    "start": "electron .",
    "dist": "node build-app.js",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --testPathPatterns=unit",
    "test:integration": "jest --config jest.config.js --testPathPatterns=integration",
    "test:e2e": "playwright test --config=playwright.config.js",
    "test:all": "npm run test && npm run test:e2e",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "lint": "echo 'No linter configured'"
  },
  "build": {
    "appId": "com.coil.calculator",
    "productName": "Coil Calculator",
    "forceCodeSigning": false,
    "asar": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@jest/globals": "^30.3.0",
    "@playwright/test": "^1.59.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^29.0.2"
  }
}
